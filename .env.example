# =============================================================================
# Allowance — Environment Reference
# Copy to `.env.local` (Next.js) / `.dev.vars` (Wrangler). NEVER commit real values.
# Rule of thumb: anything NEXT_PUBLIC_* is shipped to the browser — keep secrets out.
# =============================================================================

# ── Supabase: CLIENT (browser-safe) ──────────────────────────────────────────
# The anon key is RLS-gated and safe to expose. It is NOT a backdoor.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...ANON...

# ── Supabase: SERVER ONLY (DANGER) ───────────────────────────────────────────
# service_role BYPASSES RLS and can decrypt Vault secrets. Backend/Worker only.
# Must NEVER be prefixed NEXT_PUBLIC_, never logged, never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE...

# ── Cloudflare Worker / KV (proxy edge) ──────────────────────────────────────
# Bound in wrangler.jsonc as a KV namespace binding (not a plaintext env value).
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id
# Edge cache TTL (seconds) for the proxy context snapshot. Short = fresher balance.
KV_CONTEXT_TTL_SECONDS=60

# ── Proxy key issuance ───────────────────────────────────────────────────────
# Human-facing prefix on issued keys, e.g. alw_live_ / alw_test_.
PROXY_KEY_PREFIX=alw_live_

# ── Polar (Pro subscription, merchant of record) ─────────────────────────────
# All SERVER ONLY. Create at polar.sh → Settings → Developers / Webhooks.
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_WEBHOOK_SECRET=polar_whs_...
POLAR_PRO_PRODUCT_ID=...        # the $20/mo subscription product id

# ── Worker extras (wrangler secrets) ─────────────────────────────────────────
# RESEND_API_KEY      — low-budget alert emails (optional)
# ALERT_WEBHOOK_URL   — Slack/Discord error alerts (optional)
# ADMIN_PURGE_SECRET  — instant key revocation (must match dashboard PROXY_PURGE_SECRET)
# EDGE_ENCRYPTION_KEY — base64 of 32 random bytes

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
