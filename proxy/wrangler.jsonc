{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-wallet-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // Structured logs (NO secrets/bodies are ever logged — see lib/log.ts).
  "observability": { "enabled": true },

  // Edge cache for encrypted credentials + balance snapshots.
  // Create with: wrangler kv namespace create WALLET_KV
  "kv_namespaces": [
    { "binding": "WALLET_KV", "id": "14407e2b3fb74ec5b92c71b271b37d29", "preview_id": "92c20b8c68a44cd0afa8a1190836ee99" }
  ],

  // Per-key edge rate limit: 100 requests / 60s. namespace_id is an arbitrary
  // stable id you choose per limiter. (Open-beta binding.)
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_IP",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  },

  // Scheduled jobs. Low-balance alert sweep every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Non-secret config only. Secrets go through `wrangler secret put` (see below).
  "vars": {
    "SUPABASE_URL": "https://izcxmonodmfoebaazxxe.supabase.co",
    "KV_CONTEXT_TTL_SECONDS": "60",
    "APP_URL": "https://getallowance.dev",
    "RESEND_FROM": "Allowance <alerts@getallowance.dev>"
  }

  // SECRETS — never commit these; set them per-environment:
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  //   wrangler secret put EDGE_ENCRYPTION_KEY     # base64 of 32 random bytes
  //   wrangler secret put RESEND_API_KEY          # for low-balance alert emails
  //   wrangler secret put ALERT_WEBHOOK_URL       # optional Slack/Discord error alerts
}
