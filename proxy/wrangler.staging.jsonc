{
  // Staging worker: same code, bound to the allowance-staging Supabase project
  // and its own KV. E2E runs the full journey here so production data is never
  // touched. Deploy: npx wrangler deploy -c wrangler.staging.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allowance-proxy-staging",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "kv_namespaces": [
    { "binding": "WALLET_KV", "id": "0a3e4df98c6045caacda1cd03e27de25" }
  ],

  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RATE_LIMITER_IP",
        "type": "ratelimit",
        "namespace_id": "2002",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  },

  // No crons on staging: nothing to alert or refill.
  "vars": {
    "SUPABASE_URL": "https://zktqdnvzbencsdsvbtoz.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InprdHFkbnZ6YmVuY3Nkc3ZidG96Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyNTczMDIsImV4cCI6MjA5NjgzMzMwMn0.ooqEyRfnc7-OIk-r5hmr9tDxxLJQJt65tJkm-19EPZg",
    "KV_CONTEXT_TTL_SECONDS": "60",
    "APP_URL": "https://getallowance.dev"
  }

  // SECRETS (per-environment):
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY -c wrangler.staging.jsonc
  //   npx wrangler secret put EDGE_ENCRYPTION_KEY       -c wrangler.staging.jsonc
}
